{
  "profile": "claude-hooks",
  "os": "Any",
  "shell": "/bin/sh",
  "why": "Explicit opt-in profile for Claude Code permission hooks.",
  "clients": {
    "claude": {
      "hook_files": ["~/.claude/settings.json"]
    }
  },
  "components": [
    {
      "id": "claude-confirm",
      "type": "claude_confirm",
      "opt_in": true,
      "source": "tools/claude-confirm/confirm.py",
      "path": "~/.local/share/ai-workbench/hooks/claude-confirm.py",
      "settings": "~/.claude/settings.json"
    },
    {
      "id": "claude-mcp-confirm",
      "type": "claude_confirm",
      "opt_in": true,
      "source": "tools/claude-confirm/mcp_confirm.py",
      "path": "~/.local/share/ai-workbench/hooks/claude-mcp-confirm.py",
      "settings": "~/.claude/settings.json",
      "matcher": "mcp__.*"
    }
  ]
}
