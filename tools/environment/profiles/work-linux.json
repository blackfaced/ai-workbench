{
  "profile": "work-linux",
  "os": "Linux",
  "shell": "/bin/bash",
  "why": "Illustrative portable profile for a generic Linux workstation. Host names and paths are placeholders.",
  "hosts": {
    "dev-a": { "match_hostname": "dev-a" },
    "dev-b": { "match_hostname": "dev-b" }
  },
  "user_bin_dirs": [ "~/.local/bin" ],
  "clients": {
    "claude": { "skills_dir": "~/.claude/skills" },
    "codex": { "skills_dir": "~/.codex/skills" },
    "shared": { "skills_dir": "~/.agents/skills" },
    "trae": { "skills_dir": "~/.trae/skills" }
  },
  "components": [
    {
      "id": "test-design",
      "type": "skill",
      "name": "test-design",
      "body": "skills/test-design/SKILL.md",
      "source": "repo:skills/test-design",
      "revision": "in-repo",
      "clients": {
        "shared": {
          "dir": "~/.agents/skills",
          "files": {
            "agents/openai.yaml": "skills/test-design/clients/openai.yaml",
            "assets/design-template.md": "skills/test-design/assets/design-template.md"
          }
        }
      },
      "stale_copies": [
        "~/.codex/skills/test-design",
        "~/.trae/skills/test-design"
      ]
    },
    {
      "id": "writing-docs",
      "type": "skill",
      "name": "writing-docs",
      "body": "skills/writing-docs/SKILL.md",
      "source": "repo:skills/writing-docs",
      "revision": "in-repo",
      "depends_on": [
        "writing-for-agents"
      ],
      "clients": {
        "shared": {
          "dir": "~/.agents/skills",
          "files": {
            "agents/openai.yaml": "skills/writing-docs/clients/openai.yaml",
            "references/sources.md": "skills/writing-docs/references/sources.md"
          }
        }
      }
    },
    {
      "id": "self-test-report",
      "type": "skill",
      "name": "self-test-report",
      "install_with": [
        "writing-docs"
      ],
      "body": "skills/self-test-report/SKILL.md",
      "source": "repo:skills/self-test-report",
      "revision": "in-repo",
      "clients": {
        "shared": {
          "dir": "~/.agents/skills",
          "files": {
            "agents/openai.yaml": "skills/self-test-report/clients/openai.yaml",
            "assets/report-template.md": "skills/self-test-report/assets/report-template.md"
          }
        }
      },
      "stale_copies": [
        "~/.codex/skills/self-test-report",
        "~/.trae/skills/self-test-report"
      ]
    }
  ]
}
