{
  "profile": "work-linux",
  "os": "Linux",
  "shell": "/bin/bash",
  "why": "Illustrative portable profile for a generic Linux workstation. Host names and paths are placeholders.",
  "hosts": {
    "dev-a": { "match_hostname": "dev-a" },
    "dev-b": { "match_hostname": "dev-b" }
  },
  "user_bin_dirs": [ "~/.local/bin" ],
  "clients": {
    "claude": { "skills_dir": "~/.claude/skills" },
    "codex": { "skills_dir": "~/.codex/skills" },
    "shared": { "skills_dir": "~/.agents/skills" },
    "trae": { "skills_dir": "~/.trae/skills" }
  },
  "components": [
    {
      "id": "setup-aiwb",
      "type": "skill",
      "name": "setup-aiwb",
      "body": "skills/setup-aiwb/SKILL.md",
      "source": "repo:skills/setup-aiwb",
      "revision": "in-repo",
      "clients": {
        "shared": {
          "dir": "~/.agents/skills",
          "frontmatter": "skills/setup-aiwb/clients/shared.frontmatter.md",
          "files": {
            "agents/openai.yaml": "skills/setup-aiwb/clients/openai.yaml",
            "references/integration-guide.md": "skills/setup-aiwb/references/integration-guide.md",
            "references/integration-setup.md": "skills/setup-aiwb/references/integration-setup.md",
            "references/error-observability.md": "skills/setup-aiwb/references/error-observability.md",
            "references/project-context.md": "skills/setup-aiwb/references/project-context.md",
            "references/matt-project-baseline.md": "skills/setup-aiwb/references/matt-project-baseline.md",
            "references/botmux-startup.md": "skills/setup-aiwb/references/botmux-startup.md"
          }
        }
      },
      "stale_copies": [
        "~/.codex/skills/setup-aiwb",
        "~/.trae/skills/setup-aiwb"
      ]
    },
    {
      "id": "test-design",
      "type": "skill",
      "name": "test-design",
      "body": "skills/test-design/SKILL.md",
      "source": "repo:skills/test-design",
      "revision": "in-repo",
      "clients": {
        "shared": {
          "dir": "~/.agents/skills",
          "frontmatter": "skills/test-design/clients/shared.frontmatter.md",
          "files": {
            "agents/openai.yaml": "skills/test-design/clients/openai.yaml",
            "assets/design-template.md": "skills/test-design/assets/design-template.md"
          }
        }
      },
      "stale_copies": [
        "~/.codex/skills/test-design",
        "~/.trae/skills/test-design"
      ]
    },
    {
      "id": "writing-docs",
      "type": "skill",
      "name": "writing-docs",
      "body": "skills/writing-docs/SKILL.md",
      "source": "repo:skills/writing-docs",
      "revision": "in-repo",
      "depends_on": [
        "writing-for-agents"
      ],
      "clients": {
        "shared": {
          "dir": "~/.agents/skills",
          "frontmatter": "skills/writing-docs/clients/shared.frontmatter.md",
          "files": {
            "agents/openai.yaml": "skills/writing-docs/clients/openai.yaml",
            "references/sources.md": "skills/writing-docs/references/sources.md"
          }
        }
      }
    },
    {
      "id": "self-test-report",
      "type": "skill",
      "name": "self-test-report",
      "install_with": [
        "writing-docs"
      ],
      "body": "skills/self-test-report/SKILL.md",
      "source": "repo:skills/self-test-report",
      "revision": "in-repo",
      "clients": {
        "shared": {
          "dir": "~/.agents/skills",
          "frontmatter": "skills/self-test-report/clients/shared.frontmatter.md",
          "files": {
            "agents/openai.yaml": "skills/self-test-report/clients/openai.yaml",
            "assets/report-template.md": "skills/self-test-report/assets/report-template.md"
          }
        }
      },
      "stale_copies": [
        "~/.codex/skills/self-test-report",
        "~/.trae/skills/self-test-report"
      ]
    },
    {
      "id": "deliver-spec",
      "type": "skill",
      "name": "deliver-spec",
      "body": "skills/deliver-spec/SKILL.md",
      "source": "repo:skills/deliver-spec",
      "revision": "in-repo",
      "clients": {
        "shared": {
          "dir": "~/.agents/skills",
          "frontmatter": "skills/deliver-spec/clients/shared.frontmatter.md",
          "files": {
            "agents/openai.yaml": "skills/deliver-spec/clients/openai.yaml",
            "references/spec-acceptance.md": "skills/deliver-spec/references/spec-acceptance.md",
            "references/run-record.md": "skills/deliver-spec/references/run-record.md",
            "references/staged-review.md": "skills/deliver-spec/references/staged-review.md",
            "references/botmux.md": "skills/deliver-spec/references/botmux.md"
          }
        }
      },
      "stale_copies": [
        "~/.codex/skills/deliver-spec",
        "~/.trae/skills/deliver-spec"
      ],
      "install_with": [
        "test-design",
        "self-test-report"
      ]
    }
  ]
}
